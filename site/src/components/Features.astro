---
const features = [
  {
    title: "Graph + vector engine",
    body: "Embedded Kùzu graph DB for structure and LanceDB for semantics — one local index, no servers.",
    icon: `<circle cx="6" cy="6" r="2.4"/><circle cx="18" cy="6" r="2.4"/><circle cx="12" cy="18" r="2.4"/><path d="M7.6 7.4 11 16M16.4 7.4 13 16M8 6h8"/>`,
  },
  {
    title: "Blast radius",
    body: "Ask what breaks before you touch it. Topolox traces every transitive importer of a file or symbol.",
    icon: `<circle cx="12" cy="12" r="2.5"/><circle cx="12" cy="12" r="6.5"/><circle cx="12" cy="12" r="10"/>`,
  },
  {
    title: "Dependencies & dependents",
    body: "Resolves real imports across src/ and monorepo layouts — what a file uses, and who uses it.",
    icon: `<path d="M4 7h16M4 12h16M4 17h10"/><path d="M16 15l3 2-3 2"/>`,
  },
  {
    title: "Every MCP agent",
    body: "Claude Code, Cursor, Codex CLI, Gemini CLI, VS Code, Windsurf, Claude Desktop — one install command.",
    icon: `<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 21h8M12 18v3M8 9l2 2-2 2M13 13h3"/>`,
  },
  {
    title: "100% local & private",
    body: "Runs offline with no API key. Default embeddings are local ONNX; your code never leaves the machine.",
    icon: `<rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>`,
  },
  {
    title: "Open source, MIT",
    body: "Free forever, hackable, and on PyPI. Built behind a GraphStore protocol so the backend can be swapped.",
    icon: `<path d="M12 3l2.5 5 5.5.8-4 3.9 1 5.5L12 21l-5-2.3 1-5.5-4-3.9 5.5-.8z"/>`,
  },
];
---

<section id="features" class="relative mx-auto max-w-6xl px-6 py-24 sm:py-28">
  <div data-reveal class="max-w-2xl">
    <p class="eyebrow">what's inside</p>
    <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight">A memory layer, not another RAG bolt-on</h2>
    <p class="mt-4 text-muted">Structure-aware retrieval that understands how your code actually connects.</p>
  </div>

  <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((f, i) => (
        <div class="card p-6" data-reveal style={`--reveal-delay:${(i % 3) * 110}ms`}>
          <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-line bg-[color-mix(in_srgb,var(--color-surface)_70%,transparent)]">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-cyan)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
          </div>
          <h3 class="mt-5 text-lg font-semibold">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{f.body}</p>
        </div>
      ))
    }
  </div>
</section>
