---
const repo = "https://github.com/Karnav018/topolox";
---

<header class="fixed inset-x-0 top-0 z-50">
  <nav class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="mt-4 flex items-center justify-between rounded-full pill px-3.5 py-2 backdrop-blur-md">
      <a href="#top" class="flex items-center gap-2 text-[1.05rem] font-semibold tracking-tight" style="font-family:var(--font-display)">
        <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true">
          <line x1="16" y1="16" x2="6" y2="8" stroke="#16201c" stroke-opacity=".5" stroke-width="1.5"></line>
          <line x1="16" y1="16" x2="26" y2="24" stroke="#16201c" stroke-opacity=".5" stroke-width="1.5"></line>
          <circle cx="16" cy="16" r="6" fill="#2c6e58"></circle>
          <circle cx="6" cy="8" r="3.2" fill="#4fb98c"></circle>
          <circle cx="26" cy="24" r="3.2" fill="#e0a23c"></circle>
        </svg>
        <span>topolox</span>
      </a>

      <div class="hidden items-center gap-7 text-sm text-muted md:flex">
        <a class="transition hover:text-text" href="#proof">How it works</a>
        <a class="transition hover:text-text" href="#proof">Benchmarks</a>
        <a class="transition hover:text-text" href={`${repo}#readme`} target="_blank" rel="noopener">Docs</a>
      </div>

      <div class="flex items-center gap-2">
        <a
          href={repo}
          target="_blank"
          rel="noopener"
          class="hidden items-center gap-1.5 rounded-full border border-border-2 px-3 py-1.5 text-sm text-muted transition hover:border-accent hover:text-accent-ink sm:inline-flex"
        >
          <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
          </svg>
          <span data-stars>★</span>
        </a>
        <a href="#start" class="btn btn-primary px-4 py-2 text-sm">Get started</a>
      </div>
    </div>
  </nav>
</header>
