---
---

<section id="race" class="relative mx-auto max-w-6xl px-6 py-24 sm:py-28">
  <div data-reveal class="max-w-2xl">
    <p class="eyebrow">the difference</p>
    <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight">Same question. Same agent. Two very different bills.</h2>
    <p class="mt-4 text-muted">
      Ask “what breaks if I change <span class="font-mono text-text">db.py</span>?” One agent reads the codebase to
      find out. The other asks the graph.
    </p>
  </div>

  <div id="race-grid" class="mt-12 grid gap-5 lg:grid-cols-2" data-reveal>
    <!-- WITHOUT -->
    <div class="term relative" data-race="without">
      <div class="term-bar">
        <span class="term-dot" style="background:#ff5f57"></span>
        <span class="term-dot" style="background:#febc2e"></span>
        <span class="term-dot" style="background:#28c840"></span>
        <span class="ml-2 text-xs text-muted">agent — without topolox</span>
      </div>
      <div class="p-4 text-[13px] leading-relaxed">
        <div data-lines class="min-h-[268px] space-y-0.5"></div>
        <div class="mt-4 border-t border-line pt-3">
          <div class="flex items-center justify-between text-xs text-muted">
            <span>context window</span>
            <span><span data-pct>0</span>% used</span>
          </div>
          <div class="mt-1.5 h-2 w-full overflow-hidden rounded-full bg-[color-mix(in_srgb,var(--color-line)_70%,transparent)]">
            <div data-bar class="h-full w-0 rounded-full transition-[width] duration-300 ease-out" style="background:linear-gradient(90deg,var(--color-cyan),var(--color-heat))"></div>
          </div>
          <div class="mt-2.5 font-mono text-sm">
            <span data-tokens class="text-heat font-semibold">0</span>
            <span class="text-muted"> tokens spent</span>
          </div>
        </div>
      </div>
    </div>

    <!-- WITH -->
    <div class="term relative" data-race="with">
      <div class="absolute -top-3 right-4 z-10 hidden rounded-full bg-cyan px-2.5 py-1 text-xs font-semibold text-[#04121a]" data-winner>
        answered first ✓
      </div>
      <div class="term-bar">
        <span class="term-dot" style="background:#ff5f57"></span>
        <span class="term-dot" style="background:#febc2e"></span>
        <span class="term-dot" style="background:#28c840"></span>
        <span class="ml-2 text-xs text-muted">agent — with topolox</span>
      </div>
      <div class="p-4 text-[13px] leading-relaxed">
        <div data-lines class="min-h-[268px] space-y-0.5"></div>
        <div class="mt-4 border-t border-line pt-3">
          <div class="flex items-center justify-between text-xs text-muted">
            <span>context window</span>
            <span><span data-pct>0</span>% used</span>
          </div>
          <div class="mt-1.5 h-2 w-full overflow-hidden rounded-full bg-[color-mix(in_srgb,var(--color-line)_70%,transparent)]">
            <div data-bar class="h-full w-0 rounded-full bg-cyan transition-[width] duration-300 ease-out"></div>
          </div>
          <div class="mt-2.5 font-mono text-sm">
            <span data-tokens class="text-cyan font-semibold">0</span>
            <span class="text-muted"> tokens spent</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-6 flex items-center gap-4" data-reveal>
    <button id="race-replay" class="btn btn-ghost text-sm">↻ Replay</button>
    <p class="text-sm text-muted">Numbers from <span class="font-mono text-text">topolox benchmark</span> on a real repo (50 files sampled).</p>
  </div>
</section>

<script>
  const WINDOW = 128000;

  type Line = { t: string; cls?: string; tok?: number; d: number };

  const without: Line[] = [
    { t: '$ claude "what breaks if I change db.py?"', cls: "text-text", d: 120 },
    { t: "→ no map of the repo — searching…", cls: "text-muted", d: 520 },
    { t: "read  auth.py        +4,200", tok: 4200, d: 360 },
    { t: "read  db.py          +5,600", tok: 9800, d: 320 },
    { t: "read  models.py      +7,100", tok: 16900, d: 320 },
    { t: "read  api.py         +9,800", tok: 26700, d: 320 },
    { t: "read  orders.py      +8,400", tok: 35100, d: 300 },
    { t: "read  users.py       +6,900", tok: 42000, d: 300 },
    { t: "read  payments.py    +7,700", tok: 49700, d: 280 },
    { t: "read  worker.py      +5,500", tok: 55200, d: 280 },
    { t: "read  server.py      +8,900", tok: 64100, d: 280 },
    { t: "read  schema.py +5 more files", tok: 120326, d: 360 },
    { t: "✓ answered — context 94% full", cls: "text-heat", tok: 120326, d: 200 },
  ];

  const withT: Line[] = [
    { t: '$ claude "what breaks if I change db.py?"', cls: "text-text", d: 120 },
    { t: "→ topolox.analyze_blast_radius(db.py)", cls: "text-cyan", d: 420 },
    { t: "← 13 impacted files · 1.1ms", cls: "text-muted", tok: 6800, d: 360 },
    { t: "→ topolox.get_file_dependencies(db.py)", cls: "text-cyan", d: 360 },
    { t: "← deps + dependents resolved", cls: "text-muted", tok: 11647, d: 320 },
    { t: "✓ answered — context 9% full", cls: "text-cyan", tok: 11647, d: 200 },
  ];

  function fmt(n: number) {
    return Math.round(n).toLocaleString("en-US");
  }
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  function setup(panel: HTMLElement) {
    return {
      panel,
      lines: panel.querySelector("[data-lines]") as HTMLElement,
      bar: panel.querySelector("[data-bar]") as HTMLElement,
      pct: panel.querySelector("[data-pct]") as HTMLElement,
      tokens: panel.querySelector("[data-tokens]") as HTMLElement,
      cur: 0,
      target: 0,
    };
  }

  function tween(state: ReturnType<typeof setup>) {
    const tick = () => {
      const diff = state.target - state.cur;
      if (Math.abs(diff) < 1) {
        state.cur = state.target;
      } else {
        state.cur += diff * 0.18;
        requestAnimationFrame(tick);
      }
      state.tokens.textContent = fmt(state.cur);
      const p = Math.min(100, (state.cur / WINDOW) * 100);
      state.bar.style.width = p.toFixed(1) + "%";
      state.pct.textContent = p.toFixed(0);
    };
    requestAnimationFrame(tick);
  }

  async function play(state: ReturnType<typeof setup>, script: Line[], reduce: boolean) {
    state.lines.innerHTML = "";
    state.cur = 0;
    state.target = 0;
    state.tokens.textContent = "0";
    state.bar.style.width = "0%";
    state.pct.textContent = "0";
    for (const ln of script) {
      const el = document.createElement("div");
      el.className = (ln.cls || "text-muted") + " font-mono";
      el.textContent = ln.t;
      state.lines.appendChild(el);
      if (typeof ln.tok === "number") {
        state.target = ln.tok;
        tween(state);
      }
      await sleep(reduce ? 0 : ln.d);
    }
  }

  function run(reduce: boolean) {
    const grid = document.getElementById("race-grid");
    if (!grid) return;
    const wo = grid.querySelector('[data-race="without"]') as HTMLElement;
    const wt = grid.querySelector('[data-race="with"]') as HTMLElement;
    const winner = wt.querySelector("[data-winner]") as HTMLElement;
    winner.classList.add("hidden");
    const sWo = setup(wo);
    const sWt = setup(wt);
    play(sWo, without, reduce);
    play(sWt, withT, reduce).then(() => {
      winner.classList.remove("hidden");
    });
  }

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const grid = document.getElementById("race-grid");
  let started = false;
  if (grid) {
    if (reduce) {
      run(true);
      started = true;
    } else {
      const io = new IntersectionObserver(
        (ents) => {
          if (ents[0].isIntersecting && !started) {
            started = true;
            run(false);
          }
        },
        { threshold: 0.4 },
      );
      io.observe(grid);
    }
    document.getElementById("race-replay")?.addEventListener("click", () => run(reduce));
  }
</script>
