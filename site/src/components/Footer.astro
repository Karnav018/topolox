---
const repo = "https://github.com/Karnav018/topolox";
const links = [
  { t: "GitHub", h: repo },
  { t: "PyPI", h: "https://pypi.org/project/topolox/" },
  { t: "Changelog", h: `${repo}/blob/main/CHANGELOG.md` },
  { t: "Roadmap", h: `${repo}/blob/main/ROADMAP.md` },
  { t: "License (MIT)", h: `${repo}/blob/main/LICENSE` },
];
---

<footer class="relative border-t border-border bg-bg-2">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <div>
        <div class="flex items-center gap-2 text-lg font-semibold tracking-tight" style="font-family:var(--font-display)">
          <svg width="20" height="20" viewBox="0 0 32 32" aria-hidden="true">
            <line x1="16" y1="16" x2="6" y2="8" stroke="#16201c" stroke-opacity=".5" stroke-width="1.5"></line>
            <line x1="16" y1="16" x2="26" y2="24" stroke="#16201c" stroke-opacity=".5" stroke-width="1.5"></line>
            <circle cx="16" cy="16" r="6" fill="#2c6e58"></circle>
            <circle cx="6" cy="8" r="3.2" fill="#4fb98c"></circle>
            <circle cx="26" cy="24" r="3.2" fill="#e0a23c"></circle>
          </svg>
          <span>topolox</span>
        </div>
        <p class="mt-3 max-w-sm text-sm text-muted">
          The topological memory &amp; architecture layer for AI coding agents.
        </p>
      </div>

      <nav class="grid grid-cols-2 gap-x-10 gap-y-2 text-sm sm:grid-cols-3">
        {
          links.map((l) => (
            <a href={l.h} target="_blank" rel="noopener" class="text-muted transition hover:text-accent-ink">
              {l.t}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-3 border-t border-border pt-6 text-xs text-faint sm:flex-row sm:items-center">
      <p>MIT licensed · built for the agentic coding era.</p>
      <p class="font-mono">pip install topolox</p>
    </div>
  </div>
</footer>
