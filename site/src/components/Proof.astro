---
const repo = "https://github.com/Karnav018/topolox";
const stats = [
  { v: "5.4×", l: "median context cut" },
  { v: "8.2×", l: "mean context cut" },
  { v: "0.8ms", l: "query p50" },
  { v: "14+", l: "languages" },
];
const cmds = [
  { c: "pip install topolox", note: "install from PyPI" },
  { c: "topolox index .", note: "build the graph for this repo" },
  { c: "topolox mcp install", note: "register with your agent, then restart" },
];
const agents = ["Claude Code", "Cursor", "Codex CLI", "Gemini CLI", "VS Code", "Windsurf", "Claude Desktop"];
---

<section id="proof" class="border-t border-border bg-bg-2">
  <div class="mx-auto max-w-6xl px-6 py-24 sm:py-28">
    <!-- payoff -->
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <p class="eyebrow">the payoff</p>
        <h2 class="mt-4 text-4xl leading-[1.08] tracking-[-0.01em] sm:text-5xl">
          Most of your agent's context is wasted <span class="text-gradient">re-reading code.</span>
        </h2>
        <p class="mt-5 max-w-lg text-lg leading-relaxed text-muted">
          To answer one “what breaks if I change this?”, an agent reads the file and everything around it —
          tens of thousands of tokens. Topolox answers from the graph instead, and hands back a fraction of that.
        </p>
        <div class="mt-8 grid max-w-md grid-cols-2 gap-x-8 gap-y-5 sm:grid-cols-4 sm:gap-x-6">
          {
            stats.map((s) => (
              <div>
                <div class="text-2xl font-medium" style="font-family:var(--font-display);color:var(--color-accent-ink)">{s.v}</div>
                <div class="mt-1 text-xs leading-snug text-muted">{s.l}</div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- meltdown card -->
      <div id="meltdown" data-reveal style="--reveal-delay:120ms">
        <div class="card overflow-hidden p-8 text-center sm:p-10">
          <div class="font-mono text-xs uppercase tracking-[0.18em] text-faint"><span data-mode>reading files</span></div>
          <div data-bignum class="hot mt-3 font-mono text-5xl font-semibold tabular-nums sm:text-7xl">0</div>
          <div class="mt-1 text-sm text-muted">tokens to answer one question</div>

          <div class="relative mt-7 h-2.5 w-full overflow-hidden rounded-full" style="background:color-mix(in srgb, var(--color-border-2) 60%, transparent)">
            <div data-gauge class="h-full w-0 rounded-full" style="background:linear-gradient(90deg,var(--color-gold),var(--color-heat))"></div>
          </div>
          <div class="mt-2 flex justify-between font-mono text-[11px] text-faint">
            <span>0</span><span>128k context window</span>
          </div>

          <div data-stamp class="stamp mt-8 inline-flex items-center gap-2 rounded-full border px-4 py-2 font-medium" style="border-color:color-mix(in srgb,var(--color-accent) 45%, transparent);color:var(--color-accent-ink);background:color-mix(in srgb,var(--color-accent) 10%, transparent)">
            <span class="text-lg" style="font-family:var(--font-display)">5.4×</span> less context, same answer
          </div>
        </div>
      </div>
    </div>

    <!-- start -->
    <div id="start" class="mt-24 scroll-mt-24">
      <div class="card p-7 sm:p-10">
        <div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
          <div data-reveal>
            <p class="eyebrow">get started</p>
            <h3 class="mt-4 text-3xl tracking-[-0.01em] sm:text-4xl">Three commands, then it's just there</h3>
            <p class="mt-4 max-w-md text-muted">
              No daemon to babysit, no keys to paste. Index once, install the MCP server, and your agent gains a map
              of the codebase. Verify it yourself with <span class="font-mono text-text">topolox benchmark .</span>
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href={repo} target="_blank" rel="noopener" class="btn btn-primary">Read the docs</a>
              <a href={repo} target="_blank" rel="noopener" class="btn btn-ghost">Star on GitHub <span class="text-faint" data-stars>★</span></a>
            </div>

            <div class="mt-8 border-t border-border pt-6">
              <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-faint">works with</p>
              <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-muted">
                {agents.map((a) => <span class="transition hover:text-text">{a}</span>)}
              </div>
            </div>
          </div>

          <div data-reveal style="--reveal-delay:100ms">
            <div class="term overflow-hidden">
              <div class="flex items-center gap-1.5 border-b border-border-2 px-4 py-2.5">
                <span class="h-2.5 w-2.5 rounded-full" style="background:#e8765a"></span>
                <span class="h-2.5 w-2.5 rounded-full" style="background:#e0a23c"></span>
                <span class="h-2.5 w-2.5 rounded-full" style="background:#4fb98c"></span>
                <span class="ml-2 text-xs text-faint">bash</span>
              </div>
              <div class="space-y-2.5 p-4">
                {
                  cmds.map((cmd) => (
                    <button data-copy={cmd.c} class="group block w-full rounded-lg px-3 py-2.5 text-left transition hover:bg-bg-2">
                      <div class="flex items-center justify-between gap-3">
                        <code class="text-sm"><span class="select-none text-faint">$ </span><span class="text-text">{cmd.c}</span></code>
                        <span class="shrink-0 text-xs text-faint opacity-0 transition group-hover:opacity-100" data-copy-label>copy</span>
                      </div>
                      <div class="mt-1 font-mono text-xs text-faint"># {cmd.note}</div>
                    </button>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  [data-bignum].hot {
    color: var(--color-heat);
  }
  [data-bignum].cool {
    color: var(--color-accent);
    transition: color 0.5s ease;
  }
  [data-stamp] {
    opacity: 0;
    transform: scale(0.7) rotate(-5deg);
  }
  [data-stamp].in {
    opacity: 1;
    transform: scale(1) rotate(-2deg);
    transition: opacity 0.3s ease, transform 0.45s cubic-bezier(0.18, 1.4, 0.4, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-stamp] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const root = document.getElementById("meltdown");
  if (root) {
    const bignum = root.querySelector("[data-bignum]") as HTMLElement;
    const gauge = root.querySelector("[data-gauge]") as HTMLElement;
    const mode = root.querySelector("[data-mode]") as HTMLElement;
    const stamp = root.querySelector("[data-stamp]") as HTMLElement;
    const WINDOW = 128000, PEAK = 120326, LOW = 11647;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fmt = (n: number) => Math.round(n).toLocaleString("en-US");
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    function animate(from: number, to: number, dur: number, done?: () => void) {
      const start = performance.now();
      function tick(now: number) {
        const t = Math.min(1, (now - start) / dur), v = from + (to - from) * easeOut(t);
        bignum.textContent = fmt(v);
        gauge.style.width = ((v / WINDOW) * 100).toFixed(1) + "%";
        if (t < 1) requestAnimationFrame(tick); else done?.();
      }
      requestAnimationFrame(tick);
    }
    function run() {
      if (reduce) {
        bignum.textContent = fmt(LOW); bignum.classList.replace("hot", "cool");
        gauge.style.width = ((LOW / WINDOW) * 100).toFixed(1) + "%"; gauge.style.background = "var(--color-accent)";
        mode.textContent = "with topolox"; stamp.classList.add("in"); return;
      }
      bignum.classList.add("hot"); mode.textContent = "reading files";
      animate(0, PEAK, 1500, () => {
        setTimeout(() => {
          bignum.classList.remove("hot"); bignum.classList.add("cool"); mode.textContent = "with topolox";
          gauge.style.transition = "background 0.5s ease"; gauge.style.background = "var(--color-accent)";
          animate(PEAK, LOW, 1400, () => stamp.classList.add("in"));
        }, 800);
      });
    }
    let started = false;
    if (reduce) run();
    else {
      const io = new IntersectionObserver((ents) => { if (ents[0].isIntersecting && !started) { started = true; run(); } }, { threshold: 0.45 });
      io.observe(root);
    }
  }
</script>
